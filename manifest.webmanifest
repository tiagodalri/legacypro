{
  "id": "/",
  "name": "Legacy Pro Trading Platform",
  "short_name": "Legacy Pro",
  "description": "Legacy Pro: robôs de operação, gestão de risco e acompanhamento ao vivo, na sua própria conta da corretora.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/?origem=app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
